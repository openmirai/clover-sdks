{
  "name": "@sendclover/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript client for the Clover email API",
  "keywords": [
    "clover",
    "email",
    "api",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/openmirai/clover-sdks.git",
    "directory": "packages/typescript"
  },
  "homepage": "https://staging.sendclover.com/en/api-reference",
  "bugs": {
    "url": "https://staging.sendclover.com/en/api-reference#errors"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resend": {
      "types": "./dist/resend/index.d.ts",
      "import": "./dist/resend/index.js"
    },
    "./nestjs": {
      "types": "./dist/integrations/nestjs.d.ts",
      "import": "./dist/integrations/nestjs.js"
    },
    "./chat": {
      "types": "./dist/integrations/chat.d.ts",
      "import": "./dist/integrations/chat.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "lint": "oxlint src test",
    "format": "oxfmt src test",
    "format:check": "oxfmt --check src test",
    "quality": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:coverage",
    "prepublishOnly": "npm run quality",
    "lint:staged": "lint-staged"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "chat": ">=4"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "chat": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,mjs}": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
